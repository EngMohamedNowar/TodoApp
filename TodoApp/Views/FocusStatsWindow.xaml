<Window x:Class="TodoApp.Views.FocusStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
        Title="Focus Stats" Height="640" Width="460" MinHeight="520" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Focus Stats" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- Tab switch -->
        <Border Grid.Row="1" Background="{StaticResource InputBrush}" CornerRadius="8" Padding="3" Margin="0,0,0,18" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button Content="Summary" Padding="16,6" Command="{Binding ShowSummaryTabCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="History" Padding="16,6" Command="{Binding ShowHistoryTabCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===================== Summary tab ===================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsHistoryTabActive, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,6,0" Padding="12,14"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HoursFocusedToday, StringFormat={}{0}h}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="hours today" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="6,0" Padding="12,14"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DaysAccessed}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="days accessed" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="6,0,0,0" Padding="12,14"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DayStreak}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="day streak" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Focus Hours" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&#x276E;" FontSize="11" Width="28" Height="28"
                            Style="{StaticResource IconButtonStyle}" Command="{Binding PrevWeekCommand}"/>
                    <TextBlock Grid.Column="1" Text="{Binding WeekRangeLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="&#x276F;" FontSize="11" Width="28" Height="28"
                            Style="{StaticResource IconButtonStyle}" Command="{Binding NextWeekCommand}"/>
                </Grid>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,18"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding WeekBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0">
                                    <TextBlock Text="{Binding HoursLabel}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Height="130" VerticalAlignment="Bottom">
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="18" CornerRadius="4"
                                                behaviors:SmoothAnimation.TargetHeight="{Binding BarHeight}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding DayLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="No focus sessions logged yet - start your first one from the timer!"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== History tab ===================== -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="Clear History" HorizontalAlignment="Right" Margin="0,0,0,12"
                    Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource DangerBrush}"
                    Command="{Binding ClearHistoryCommand}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding HistoryRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DateLabel}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeRangeLabel}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="6"
                                                Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DurationLabel}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No sessions logged yet." FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,20,0,0" HorizontalAlignment="Center"
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
