<Window x:Class="TodoApp.Views.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TodoApp.Helpers"
        helpers:WindowTheme.DarkTitleBar="True"
        Title="Accent Color"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.18"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>

    <StackPanel Margin="24">

        <TextBlock Text="Accent color" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4"/>

        <TextBlock Text="Applies instantly and is remembered."
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,0,0,16"/>

        <WrapPanel x:Name="SwatchesPanel"
                   Margin="0,0,0,20"/>

        <Button Content="Close"
                Width="90"
                Height="32"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Close_Click"/>

    </StackPanel>

</Window>
