<Window x:Class="TodoApp.Views.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Category"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Opacity="0">



    <!-- =========================
         Fade In
    ========================== -->

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>


    <!-- =========================
         Main Dialog
    ========================== -->

    <Border Background="{StaticResource WindowBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- =========================
                 Header
            ========================== -->

            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="16,16,0,0">
                <Grid Margin="24,20,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12">
                        <TextBlock Text="＋"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Add Category"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Create or delete a task category"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- =========================
                 Add Category
            ========================== -->

            <StackPanel Grid.Row="1" Margin="24,22,24,4">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CATEGORY NAME"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=CategoryNameBox, Path=Text.Length, StringFormat={}{0}/30}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>

                <TextBox x:Name="CategoryNameBox"
                         Height="40"
                         MaxLength="30"
                         />
            </StackPanel>


            <!-- Divider -->
            <Border Grid.Row="2" Height="1" Background="{StaticResource BorderSoftBrush}" Margin="24,18,24,18"/>


            <!-- =========================
                 Delete Category
            ========================== -->

            <StackPanel Grid.Row="3" Margin="24,0,24,24">
                <TextBlock Text="DELETE EXISTING CATEGORY"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CategoryDeleteComboBox"
                              Grid.Column="0"
                              Height="40"
                              />

                    <Button x:Name="DeleteCategoryButton"
                            Grid.Column="2"
                            Content="Delete"
                            Width="80"
                            Height="40"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="{StaticResource DangerBrush}"
                            Click="DeleteCategoryButton_Click"/>
                </Grid>
            </StackPanel>


            <!-- =========================
                 Bottom Buttons
            ========================== -->

            <Border Grid.Row="4" Background="{StaticResource SidebarBrush}" CornerRadius="0,0,16,16">
                <Grid Margin="24,16,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="Cancel"
                            Width="90"
                            Height="36"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="3"
                            x:Name="AddButton"
                            Content="Add Category"
                            Width="120"
                            Height="36"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddButton_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>
