<Window x:Class="TodoApp.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">


    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.18"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="28,24,28,24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Header -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                       Text="Task Details"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,16"/>


            <!-- ================================================= -->
            <!-- Icon + Title row -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <ComboBox x:Name="IconBox"
                          Grid.Column="0"
                          Width="64"
                          Height="44"
                          FontSize="20"
                          SelectedIndex="0"/>

                <TextBox x:Name="TitleBox"
                         Grid.Column="2"
                         Height="44"
                         FontSize="19"
                         FontWeight="SemiBold"
                         Padding="10,0"
                         VerticalContentAlignment="Center"/>

            </Grid>


            <!-- ================================================= -->
            <!-- Meta info -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,10,0,16">

                <TextBlock x:Name="CreatedText"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="CompletedText"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,10,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- Description -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="3"
                       Text="Description"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,7"/>


            <TextBox x:Name="DescriptionBox"
                     Grid.Row="4"
                     FontSize="13.5"
                     Padding="10,8"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,18"
                     SizeChanged="DescriptionBox_SizeChanged"
                     TextChanged="DescriptionBox_TextChanged"/>


            <!-- ================================================= -->
            <!-- Properties grid: category / priority / due / repeat -->
            <!-- ================================================= -->

            <Grid Grid.Row="5"

                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Category"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,6"/>


                <ComboBox x:Name="CategoryBox"
                          Grid.Row="1" Grid.Column="0"
                          Height="40"
                          IsEditable="True"
                          VerticalContentAlignment="Center"/>


                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Priority"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,6"/>


                <ComboBox x:Name="PriorityBox"
                          Grid.Row="1" Grid.Column="2"
                          Height="40"
                          SelectedIndex="1"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>

                </ComboBox>


                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Due date"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,6"/>


                <DatePicker x:Name="DueDatePicker"
                            Grid.Row="3" Grid.Column="0"
                            Height="40"
                            VerticalContentAlignment="Center"/>


                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="Repeat"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,6"/>


                <ComboBox x:Name="RecurrenceBox"
                          Grid.Row="3" Grid.Column="2"
                          Height="40"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Never"/>
                    <ComboBoxItem Content="↻ Daily"/>
                    <ComboBoxItem Content="↻ Weekly"/>
                    <ComboBoxItem Content="↻ Monthly"/>

                </ComboBox>

            </Grid>


            <!-- ================================================= -->
            <!-- Tags -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="6"
                       Text="Tags (comma separated)"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,6"/>


            <TextBox x:Name="TagsBox"
                     Grid.Row="7"
                     Height="40"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,18"/>


            <!-- ================================================= -->
            <!-- Attachments -->
            <!-- ================================================= -->

            <Grid Grid.Row="8"

                  Margin="0,0,0,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Attachments"
                    Style="{StaticResource FieldLabelStyle}"/>

                <Button x:Name="AddAttachmentButton"
                        Grid.Column="1"
                        Content="+  Attach file"
                        Height="30"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddAttachmentButton_Click"/>

            </Grid>


            <ListBox x:Name="AttachmentsList"
                     Grid.Row="9"
                     MaxHeight="120"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,0,0,18"
                     MouseDoubleClick="AttachmentsList_MouseDoubleClick">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xE8E5;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding}"
                                FontSize="12"
                                Foreground="#C9CDD8"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                ToolTip="{Binding}"/>

                            <Button
                                Grid.Column="2"
                                Content="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#5C6274"
                                Cursor="Hand"
                                Click="RemoveAttachment_Click"
                                Tag="{Binding}"/>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


            <!-- ================================================= -->
            <!-- Buttons -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="10"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="95"
                        Height="36"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Save Changes"
                        Width="120"
                        Height="36"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>
