<Window x:Class="TodoApp.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TodoApp.Helpers"
        helpers:WindowTheme.DarkTitleBar="True"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        Title="AI Agent"
        Width="560"
        Height="720"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,12">
            <Border Width="30" Height="36" CornerRadius="8" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentColorDark}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="AI Agent" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Settings -->
        <Expander Grid.Row="1"
                  Header="Server settings"
                  Margin="0,0,0,10"
                  Foreground="{StaticResource TextSecondaryBrush}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Endpoint (LM Studio Local Server)"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" FontSize="13"
                         Background="{StaticResource InputBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush2}"
                         BorderThickness="1" VerticalContentAlignment="Center"/>
                <TextBlock Text="Model name (leave empty to auto-select the loaded model)"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" FontSize="13"
                         Background="{StaticResource InputBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush2}"
                         BorderThickness="1" VerticalContentAlignment="Center"/>
                <TextBlock Text="Local server, no API key needed. Start it in LM Studio → Developer → Start Server."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save" Width="80" Height="36"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveSettingsCommand}"/>
                    <Button Content="Test connection" Width="130" Height="36" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TestConnectionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Chat -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="12">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessage}">
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    CornerRadius="9"
                                    MaxWidth="440"
                                    HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource InputBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTool}" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="10.5" FontWeight="Bold" Margin="0,0,0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                        <Setter Property="Text" Value="AI"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="tool">
                                                        <Setter Property="Text" Value="action"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Text" Value="You"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Composer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Height="40"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource InputBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush2}"
                     BorderThickness="1"
                     FontSize="13.5"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="False">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Content="Send"
                    Width="84" Height="40" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SendCommand}"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="2,6,0,0"/>
    </Grid>

</Window>
