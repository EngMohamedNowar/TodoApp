<Window x:Class="TodoApp.Views.AddEditTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">

    <!-- =========================================================
         RESOURCES
         ========================================================= -->



    <!-- =========================================================
         WINDOW ANIMATION
         ========================================================= -->

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.18"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <TextBlock x:Name="HeaderText"
                   Text="{Binding HeaderText}"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,24"/>


        <!-- =====================================================
             TITLE
             ===================================================== -->

        <TextBlock Grid.Row="1"
                   Text="Title"
                   Style="{StaticResource FieldLabelStyle}"/>


            <TextBox x:Name="TitleBox"
                      Grid.Row="2"
                      Height="40"
                      Padding="10,0"
                      VerticalContentAlignment="Center"
                      Margin="0,0,0,18"
                      Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>


        <!-- =====================================================
             DESCRIPTION
             ===================================================== -->

        <TextBlock Grid.Row="3"
                   Text="Description"
                   Style="{StaticResource FieldLabelStyle}"/>


            <TextBox x:Name="DescriptionBox"
                     Grid.Row="4"
                     FontSize="13"
                     Height="80"
                     Padding="10,8"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,18"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>


        <!-- =====================================================
             CATEGORY + PRIORITY
             ===================================================== -->

        <Grid Grid.Row="5"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                 CATEGORY LABEL
                 ================================================= -->

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Category"
                       Style="{StaticResource FieldLabelStyle}"/>


            <!-- =================================================
                 CATEGORY COMBOBOX
                 ================================================= -->

            <ComboBox x:Name="CategoryBox"
                       Grid.Row="1"
                       Grid.Column="0"
                       Height="40"
                       IsEditable="True"
                       IsTextSearchEnabled="True"
                       VerticalContentAlignment="Center"
                       ItemsSource="{Binding Categories}"
                       Text="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- =================================================
                 PRIORITY LABEL
                 ================================================= -->

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Priority"
                       Style="{StaticResource FieldLabelStyle}"/>


            <!-- =================================================
                 PRIORITY
                 ================================================= -->

            <ComboBox x:Name="PriorityBox"
                      Grid.Row="1"
                      Grid.Column="2"
                      Height="40"
                      SelectedIndex="{Binding SelectedPriorityIndex}"
                      VerticalContentAlignment="Center">

                <ComboBoxItem Content="Low"/>

                <ComboBoxItem Content="Medium"/>

                <ComboBoxItem Content="High"/>

            </ComboBox>

        </Grid>


        <!-- =====================================================
              DUE DATE + RECURRENCE
              ===================================================== -->

        <Grid Grid.Row="6"
              Margin="0,0,0,7">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Due date"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,0"/>

            <TextBlock Grid.Column="2"
                       Text="Repeat"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,0"/>

        </Grid>


        <Grid Grid.Row="7"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <DatePicker x:Name="DueDatePicker"
                        Grid.Column="0"
                        Height="40"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        SelectedDate="{Binding DueDate}"/>

            <ComboBox x:Name="RecurrenceBox"
                      Grid.Column="2"
                      Height="40"
                      SelectedIndex="{Binding RecurrenceIndex}"
                      VerticalContentAlignment="Center">

                <ComboBoxItem Content="Never"/>

                <ComboBoxItem Content="↻ Daily"/>

                <ComboBoxItem Content="↻ Weekly"/>

                <ComboBoxItem Content="↻ Monthly"/>

            </ComboBox>

        </Grid>


        <!-- =====================================================
             BUTTONS
             ===================================================== -->

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="95"
                    Height="36"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>


            <Button x:Name="SaveButton"
                    Content="Save Task"
                    Width="105"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>