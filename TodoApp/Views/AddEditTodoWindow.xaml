<Window x:Class="TodoApp.Views.AddEditTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TodoApp.Helpers"
        helpers:WindowTheme.DarkTitleBar="True"
        Title="Task"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">

    <!-- =========================================================
         WINDOW ANIMATION
         ========================================================= -->

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="28,24,28,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <TextBlock x:Name="HeaderText"
                       Grid.Row="0"
                       Text="{Binding HeaderText}"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,16"/>


            <!-- =================================================
                 ICON + TITLE
                 ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="IconBox"
                          Grid.Column="0"
                          Width="64"
                          Height="48"
                          FontSize="20"
                          SelectedIndex="0"/>

                <TextBox x:Name="TitleBox"
                         Grid.Column="2"
                         Height="48"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>


            <!-- =================================================
                 DESCRIPTION
                 ================================================= -->

            <TextBlock Grid.Row="2"
                       Text="Description"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,7"/>

            <TextBox x:Name="DescriptionBox"
                     Grid.Row="3"
                     FontSize="15"
                     Padding="10,8"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,18"
                     SizeChanged="DescriptionBox_SizeChanged"
                     TextChanged="DescriptionBox_TextChanged"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- =================================================
                 CATEGORY / PRIORITY / DUE DATE / REPEAT
                 ================================================= -->

            <Grid Grid.Row="4"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Category"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,6"/>


                <ComboBox x:Name="CategoryBox"
                          Grid.Row="1" Grid.Column="0"
                          Height="46"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Categories}"
                          Text="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"/>


                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Priority"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,6"/>


                <ComboBox x:Name="PriorityBox"
                          Grid.Row="1" Grid.Column="2"
                          Height="46"
                          SelectedIndex="{Binding SelectedPriorityIndex}"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>

                </ComboBox>


                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Due date"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,6"/>


                <DatePicker x:Name="DueDatePicker"
                            Grid.Row="3" Grid.Column="0"
                            Height="46"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding DueDate}"/>


                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="Repeat"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,6"/>


                <ComboBox x:Name="RecurrenceBox"
                          Grid.Row="3" Grid.Column="2"
                          Height="46"
                          SelectedIndex="{Binding RecurrenceIndex}"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Never"/>
                    <ComboBoxItem Content="↻ Daily"/>
                    <ComboBoxItem Content="↻ Weekly"/>
                    <ComboBoxItem Content="↻ Monthly"/>

                </ComboBox>

            </Grid>


            <!-- =================================================
                 TAGS
                 ================================================= -->

            <TextBlock Grid.Row="5"
                       Text="Tags (comma separated)"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,6"/>


            <TextBox x:Name="TagsBox"
                     Grid.Row="6"
                     Height="46"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,18"
                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- =================================================
                 BUTTONS
                 ================================================= -->

            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="95"
                        Height="36"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>


                <Button x:Name="SaveButton"
                        Content="Save Task"
                        Width="120"
                        Height="36"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>
