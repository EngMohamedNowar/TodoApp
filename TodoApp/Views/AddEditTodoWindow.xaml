<Window x:Class="TodoApp.Views.AddEditTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Opacity="0">

    <!-- =========================================================
         RESOURCES
         ========================================================= -->

    <Window.Resources>

        <!-- =====================================================
             DARK TEXTBOX
             ===================================================== -->

        <Style x:Key="DarkTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                    Value="#1B1B24"/>

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="BorderBrush"
                    Value="#30303D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

            <Setter Property="SelectionBrush"
                    Value="#5146A5"/>

            <Setter Property="SelectionTextBrush"
                    Value="White"/>

        </Style>


        <!-- =====================================================
             DARK COMBOBOX
             ===================================================== -->

        <Style x:Key="DarkComboBoxStyle"
               TargetType="{x:Type ComboBox}">

            <Setter Property="Background"
                    Value="#1B1B24"/>

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="BorderBrush"
                    Value="#30303D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <!-- =================================================
                                 MAIN COMBOBOX
                                 ================================================= -->

                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">

                                <Grid>

                                    <!-- Editable TextBox -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Visibility="Collapsed"
                                             Background="Transparent"
                                             Foreground="#F5F5F7"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="White"
                                             SelectionBrush="#5146A5"
                                             SelectionTextBrush="White"/>


                                    <!-- Selected Item -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="10,0,40,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>


                                    <!-- Arrow -->
                                    <ToggleButton x:Name="DropDownButton"
                                                  Width="36"
                                                  HorizontalAlignment="Right"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0">

                                        <Path Data="M 0 0 L 5 5 L 10 0"
                                              Stroke="#A8A8B8"
                                              StrokeThickness="1.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                                    </ToggleButton>

                                </Grid>

                            </Border>


                            <!-- =================================================
                                 DROPDOWN
                                 ================================================= -->

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">

                                <Border Width="{Binding ActualWidth,
                                                RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#1B1B24"
                                        BorderBrush="#3A3948"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0">

                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <!-- =================================================
                             COMBOBOX TRIGGERS
                             ================================================= -->

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#5146A5"/>

                            </Trigger>


                            <!-- Focus -->
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#6D5DD3"/>

                            </Trigger>


                            <!-- Editable -->
                            <Trigger Property="IsEditable"
                                     Value="True">

                                <Setter TargetName="PART_EditableTextBox"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter TargetName="ContentSite"
                                        Property="Visibility"
                                        Value="Collapsed"/>

                            </Trigger>


                            <!-- Disabled -->
                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="MainBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>


            <!-- =====================================================
                 COMBOBOX ITEMS
                 ===================================================== -->

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="{x:Type ComboBoxItem}">

                        <Setter Property="Background"
                                Value="#1B1B24"/>

                        <Setter Property="Foreground"
                                Value="#F5F5F7"/>

                        <Setter Property="Padding"
                                Value="10,9"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <ControlTemplate.Triggers>

                                        <!-- Hover -->
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#302A5C"/>

                                            <Setter Property="Foreground"
                                                    Value="White"/>

                                        </Trigger>


                                        <!-- Selected -->
                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#5146A5"/>

                                            <Setter Property="Foreground"
                                                    Value="White"/>

                                        </Trigger>


                                        <!-- Disabled -->
                                        <Trigger Property="IsEnabled"
                                                 Value="False">

                                            <Setter Property="Opacity"
                                                    Value="0.5"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             DARK DATEPICKER
             ===================================================== -->

        <Style x:Key="DarkDatePickerStyle"
               TargetType="{x:Type DatePicker}">

            <Setter Property="Background"
                    Value="#1B1B24"/>

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="BorderBrush"
                    Value="#30303D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         WINDOW ANIMATION
         ========================================================= -->

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.18"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <TextBlock x:Name="HeaderText"
                   Text="New Task"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,24"/>


        <!-- =====================================================
             TITLE
             ===================================================== -->

        <TextBlock Grid.Row="1"
                   Text="Title"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,7"/>


        <TextBox x:Name="TitleBox"
                 Grid.Row="2"
                 Height="38"
                 Padding="10,0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,18"
                 Style="{StaticResource DarkTextBoxStyle}"/>


        <!-- =====================================================
             DESCRIPTION
             ===================================================== -->

        <TextBlock Grid.Row="3"
                   Text="Description"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,7"/>


        <TextBox x:Name="DescriptionBox"
                 Grid.Row="4"
                 FontSize="13"
                 Height="80"
                 Padding="10,8"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,18"
                 Style="{StaticResource DarkTextBoxStyle}"/>


        <!-- =====================================================
             CATEGORY + PRIORITY
             ===================================================== -->

        <Grid Grid.Row="5"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                 CATEGORY LABEL
                 ================================================= -->

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Category"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,7"/>


            <!-- =================================================
                 CATEGORY COMBOBOX + ADD BUTTON
                 ================================================= -->

            <Grid Grid.Row="1"
                  Grid.Column="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="8"/>

                    <ColumnDefinition Width="36"/>

                </Grid.ColumnDefinitions>


                <!-- CATEGORY -->

                <ComboBox x:Name="CategoryBox"
                          Grid.Column="0"
                          Height="38"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          VerticalContentAlignment="Center"
                          Style="{StaticResource DarkComboBoxStyle}"/>


                <!-- ADD CATEGORY -->

                <Button x:Name="AddCategoryButton"
                        Grid.Column="2"
                        Content="+"
                        Width="36"
                        Height="36"
                        FontSize="18"
                        Padding="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddCategoryButton_Click"/>

            </Grid>


            <!-- =================================================
                 PRIORITY LABEL
                 ================================================= -->

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Priority"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,7"/>


            <!-- =================================================
                 PRIORITY
                 ================================================= -->

            <ComboBox x:Name="PriorityBox"
                      Grid.Row="1"
                      Grid.Column="2"
                      Height="38"
                      SelectedIndex="1"
                      VerticalContentAlignment="Center"
                      Style="{StaticResource DarkComboBoxStyle}">

                <ComboBoxItem Content="Low"/>

                <ComboBoxItem Content="Medium"/>

                <ComboBoxItem Content="High"/>

            </ComboBox>

        </Grid>


        <!-- =====================================================
             DUE DATE
             ===================================================== -->

        <TextBlock Grid.Row="6"
                   Text="Due date"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,7"/>


        <DatePicker x:Name="DueDatePicker"
                    Grid.Row="7"
                    Height="38"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="0,0,0,22"
                    Style="{StaticResource DarkDatePickerStyle}"/>


        <!-- =====================================================
             BUTTONS
             ===================================================== -->

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="95"
                    Height="36"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>


            <Button x:Name="SaveButton"
                    Content="Save Task"
                    Width="105"
                    Height="36"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>