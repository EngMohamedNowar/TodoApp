<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
        Title="My Tasks"
        Height="680"
        Width="980"
        MinHeight="520"
        MinWidth="760"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <!-- ========================================================= -->
    <!-- Window Animation -->
    <!-- ========================================================= -->

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.22"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>


    <!-- ========================================================= -->
    <!-- Keyboard Shortcuts -->
    <!-- ========================================================= -->

    <Window.InputBindings>

        <KeyBinding Modifiers="Control"
                    Key="N"
                    Command="{Binding AddCommand}"/>

        <KeyBinding Modifiers="Control"
                    Key="Z"
                    Command="{Binding UndoDeleteCommand}"/>

    </Window.InputBindings>


    <!-- ========================================================= -->
    <!-- Main Layout -->
    <!-- ========================================================= -->
    <!-- Main Layout -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="230"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- Sidebar -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,1,0">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="18,24,18,18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- Logo -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="2,0,0,28">

                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0">

                        <Border.Background>

                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,1">

                                <GradientStop
                                    Color="#8B7CF6"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#4C3CB0"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>


                        <Path
                            Data="M 6 15 L 11 20 L 22 7"
                            Stroke="White"
                            StrokeThickness="2.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>

                    </Border>


                    <TextBlock
                        Text="My Tasks"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Main Buttons -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1">

                    <Button
                        Content="+  New Task"
                        Margin="0,0,0,10"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"/>


                    <Button
                        Content="⏱  Focus Timer"
                        Height="34"
                        Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenTimerCommand}"/>

                    <Grid Margin="0,6,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="6"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="📊  Stats"
                            Height="30"
                            FontSize="11.5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenDashboardCommand}"
                            ToolTip="Open dashboard"/>

                        <Button
                            Grid.Column="2"
                            Content="🎨  Theme"
                            Height="30"
                            FontSize="11.5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenThemePickerCommand}"
                            ToolTip="Change accent color"/>

                    </Grid>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Filters -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,20">

                    <TextBlock
                        Text="FILTERS"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="6,0,0,8"/>


                    <Button
                        Content="All Tasks"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="All"/>


                    <Button
                        Content="Active"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Active"/>


                    <Button
                        Content="Completed"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Completed"/>


                    <Button
                        Content="★  Starred"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Starred"/>


                    <Button
                        Content="🗄  Archive"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Archived"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Categories -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3">

                    <TextBlock
                        Text="CATEGORIES"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="6,0,0,8"/>


                    <ListBox
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        BorderThickness="0"
                        Background="Transparent"
                        MaxHeight="180"
                        ItemContainerStyle="{StaticResource NavListBoxItemStyle}"/>

                    <Button
                        Content="Manage Categories"
                        Style="{StaticResource SidebarButtonStyle}"
                        FontSize="12"
                        Margin="0,6,0,0"
                        Click="ManageCategories_Click"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Progress -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="5">


                    <Grid Margin="6,0,0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Column="0"
                            Text="PROGRESS"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextMutedBrush}"/>


                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding CompletionPercentage, StringFormat={}{0}%}"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="11"
                            FontWeight="Bold"/>

                    </Grid>


                    <!-- Progress Bar -->

                    <Border
                        Height="8"
                        CornerRadius="4"
                        Background="{StaticResource InputBrush}"
                        Margin="6,0,0,6">

                        <Border
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            behaviors:SmoothAnimation.TargetWidth="{Binding CompletionPercentage, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=190}">

                            <Border.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,0">

                                    <GradientStop
                                        Color="#8B7CF6"
                                        Offset="0"/>

                                    <GradientStop
                                        Color="#6C5CE7"
                                        Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                        </Border>

                    </Border>


                    <TextBlock
                        Text="{Binding StatusText}"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="6,0,0,10"/>


                    <Button
                        Content="Clear completed"
                        Style="{StaticResource SidebarButtonStyle}"
                        FontSize="12"
                        Command="{Binding ClearCompletedCommand}"/>

                </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- Main Content -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            Margin="28,24,28,24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Bulk Actions Bar (visible when selection exists) -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="8"
                Padding="12,7"
                Margin="0,0,0,14"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        Text="&#xE762;"
                        Foreground="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>

                    <Button
                        Content="Delete selected"
                        Height="28"
                        Padding="12,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeleteSelectedCommand}"
                        Margin="0,0,8,0"/>

                    <Button
                        Content="Clear selection"
                        Height="28"
                        Padding="12,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearSelectionCommand}"/>

                    <TextBlock
                        Text="Tip: Ctrl+Click cards to select multiple · double-click to open details"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- Search Box + Sort -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,18">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Height="38"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <Grid>


                        <!-- Search Icon -->

                        <TextBlock
                            Text="&#xE721;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"
                            IsHitTestVisible="False"/>


                        <!-- TextBox -->

                        <TextBox
                            x:Name="SearchBox"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Padding="34,0,10,0"
                            VerticalContentAlignment="Center"
                            ToolTip="Search tasks..."/>


                        <!-- Placeholder -->

                        <TextBlock
                            Text="Search tasks..."
                            FontSize="13"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="34,0,10,0"
                            IsHitTestVisible="False">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>


                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding Text, ElementName=SearchBox}"
                                            Value="">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Border>


                <!-- Sort Selector -->

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Sort:"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                    <ComboBox
                        x:Name="SortBox"
                        Width="130"
                        Height="34"
                        FontSize="12.5"
                        SelectedIndex="{Binding SortModeIndex, Mode=TwoWay}">

                        <ComboBoxItem Content="Manual"/>

                        <ComboBoxItem Content="Due Date"/>

                        <ComboBoxItem Content="Priority"/>

                        <ComboBoxItem Content="Created"/>

                    </ComboBox>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- Todo List -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding TodosView}">


                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>


                            <!-- ================================================= -->
                            <!-- Todo Card -->
                            <!-- ================================================= -->

                            <Border
                                x:Name="card"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,10"
                                BorderThickness="1"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                AllowDrop="True"
                                DragOver="Card_DragOver"
                                Drop="Card_Drop"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">

                                <Border.InputBindings>

                                    <MouseBinding
                                        Gesture="LeftDoubleClick"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>

                                </Border.InputBindings>


                                <!-- Card Transform -->

                                <Border.RenderTransform>

                                    <TranslateTransform
                                        x:Name="cardOffset"
                                        Y="10"/>

                                </Border.RenderTransform>


                                <!-- Card Animation -->

                                <Border.Triggers>

                                    <EventTrigger
                                        RoutedEvent="FrameworkElement.Loaded">

                                        <BeginStoryboard>

                                            <Storyboard>


                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.22"/>


                                                <DoubleAnimation
                                                    Storyboard.TargetName="cardOffset"
                                                    Storyboard.TargetProperty="Y"
                                                    To="0"
                                                    Duration="0:0:0.28">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase
                                                            EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>


                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                </Border.Triggers>


                                <!-- Hover Style -->

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter
                                            Property="BorderBrush"
                                            Value="{StaticResource BorderBrush2}"/>


                                        <Style.Triggers>

                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">

                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>

                                            </Trigger>


                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                Value="True">

                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>

                                                <Setter
                                                    Property="Background"
                                                    Value="{StaticResource AccentSoftBrush}"/>

                                                <Setter
                                                    Property="BorderThickness"
                                                    Value="2"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>


                                <!-- ================================================= -->
                                <!-- Card Content -->
                                <!-- ================================================= -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <!-- Drag -->

                                        <ColumnDefinition Width="Auto"/>

                                        <!-- Priority Line -->

                                        <ColumnDefinition Width="6"/>

                                        <!-- Checkbox -->

                                        <ColumnDefinition Width="Auto"/>

                                        <!-- Content -->

                                        <ColumnDefinition Width="*"/>

                                        <!-- Buttons -->

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- ================================================= -->
                                    <!-- Drag Handle -->
                                    <!-- ================================================= -->

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="⠿"
                                        FontSize="14"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Cursor="SizeAll"
                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                        MouseMove="DragHandle_MouseMove"
                                        ToolTip="Drag to reorder"/>


                                    <!-- ================================================= -->
                                    <!-- Priority Indicator -->
                                    <!-- ================================================= -->

                                    <Border
                                        Grid.Column="1"
                                        Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="0,0,12,0"/>


                                    <!-- ================================================= -->
                                    <!-- CheckBox -->
                                    <!-- ================================================= -->

                                    <CheckBox
                                        Grid.Column="2"
                                        IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                        VerticalAlignment="Top"
                                        Margin="0,2,14,0"
                                        Cursor="Hand"/>


                                    <!-- ================================================= -->
                                    <!-- Todo Information -->
                                    <!-- ================================================= -->

                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center">


                                        <!-- Icon + Title -->

                                        <StackPanel
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Text="{Binding DisplayIcon}"
                                                FontSize="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DisplayIcon, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"/>

                                        </StackPanel>


                                        <!-- Description -->

                                        <TextBlock
                                            Text="{Binding Description}"
                                            FontSize="12.5"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Description, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>


                                        <!-- ================================================= -->
                                        <!-- Metadata -->
                                        <!-- ================================================= -->

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,7,0,0">


                                            <!-- Category -->

                                            <Border
                                                Background="{StaticResource InputBrush}"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding Category, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">

                                                <TextBlock
                                                    Text="{Binding Category}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- Priority Badge -->
                                            <!-- ================================================= -->

                                            <Border
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}">

                                                <TextBlock
                                                    Text="{Binding PriorityText}"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"/>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- Recurrence Badge -->
                                            <!-- ================================================= -->

                                            <Border
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                Background="#2E5E4E"
                                                Visibility="{Binding RecurrenceText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">

                                                <TextBlock
                                                    Text="{Binding RecurrenceText}"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="#7BE0B0"/>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- Due Date -->
                                            <!-- ================================================= -->

                                            <TextBlock
                                                Text="{Binding DueDateDisplay}"
                                                FontSize="11">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource TextSecondaryBrush}"/>


                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding IsOverdue}"
                                                                Value="True">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}"/>

                                                                <Setter
                                                                    Property="FontWeight"
                                                                    Value="SemiBold"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </StackPanel>


                                        <!-- ================================================= -->
                                        <!-- Tags chips -->
                                        <!-- ================================================= -->

                                        <ItemsControl
                                            ItemsSource="{Binding TagsList}"
                                            Margin="0,7,0,0"
                                            Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <StackPanel Orientation="Horizontal"/>

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border
                                                        Background="#26314A"
                                                        BorderBrush="#3A4A6E"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="8,1.5"
                                                        Margin="0,0,6,0">

                                                        <TextBlock
                                                            Text="{Binding}"
                                                            FontSize="10.5"
                                                            Foreground="#8FB4FF"/>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>


                                        <!-- ================================================= -->
                                        <!-- Sub-tasks -->
                                        <!-- ================================================= -->

                                        <ItemsControl
                                            ItemsSource="{Binding SubTasks}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding HasSubTasks, Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <StackPanel/>

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border
                                                        Background="{StaticResource InputBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,5"
                                                        Margin="0,0,0,4">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="Auto"/>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox
                                                                Grid.Column="0"
                                                                IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"/>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding Title}"
                                                                FontSize="12"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"/>

                                                            <Button
                                                                Grid.Column="2"
                                                                Content="&#xE74D;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>


                                    <!-- ================================================= -->
                                    <!-- Edit / Delete -->
                                    <!-- ================================================= -->

                                    <StackPanel
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">


                                        <!-- Star / Favorite -->

                                        <Button
                                            Content="{Binding FavoriteGlyph}"
                                            FontSize="15"
                                            ToolTip="Star task"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,2,0">

                                            <Button.Style>

                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource IconButtonStyle}">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource TextMutedBrush}"/>


                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsFavorite}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="#FFD43B"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- Archive (hidden in archived view) -->

                                        <Button
                                            Content="&#xE7B8;"
                                            FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Archive"
                                            Command="{Binding DataContext.ArchiveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0">

                                            <Button.Style>

                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource IconButtonStyle}">


                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding DataContext.Filter, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Value="Archived">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- Unarchive (only in archived view) -->

                                        <Button
                                            Content="&#xE72C;"
                                            FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Restore from archive"
                                            Command="{Binding DataContext.UnarchiveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0">

                                            <Button.Style>

                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource IconButtonStyle}">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed"/>


                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding DataContext.Filter, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Value="Archived">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- Add Sub-Task -->

                                        <Button
                                            Content="&#xE710;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Add sub-task"
                                            Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0"/>


                                        <!-- Edit -->

                                        <Button
                                            Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0"/>


                                        <!-- Delete -->

                                        <Button
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>