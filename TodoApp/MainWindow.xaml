<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
        Title="My Tasks"
        Height="680"
        Width="980"
        MinHeight="520"
        MinWidth="760"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <!-- ========================================================= -->
    <!-- Window Animation -->
    <!-- ========================================================= -->

    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard>

                <Storyboard>

                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.22"/>

                </Storyboard>

            </BeginStoryboard>

        </EventTrigger>

    </Window.Triggers>


    <!-- ========================================================= -->
    <!-- ViewModel -->
    <!-- ========================================================= -->

    <Window.DataContext>

        <vm:MainViewModel/>

    </Window.DataContext>


    <!-- ========================================================= -->
    <!-- Main Layout -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="230"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- Sidebar -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,24,18,18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- Logo -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="2,0,0,28">

                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0">

                        <Border.Background>

                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,1">

                                <GradientStop
                                    Color="#8B7CF6"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#4C3CB0"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>


                        <Path
                            Data="M 6 15 L 11 20 L 22 7"
                            Stroke="White"
                            StrokeThickness="2.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"/>

                    </Border>


                    <TextBlock
                        Text="My Tasks"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Main Buttons -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1">

                    <Button
                        Content="+  New Task"
                        Margin="0,0,0,10"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"/>


                    <Button
                        Content="⏱  Focus Timer"
                        Height="34"
                        Margin="0,0,0,4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenTimerCommand}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Filters -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,20">

                    <TextBlock
                        Text="FILTERS"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="6,0,0,8"/>


                    <Button
                        Content="All Tasks"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="All"/>


                    <Button
                        Content="Active"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Active"/>


                    <Button
                        Content="Completed"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Completed"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Categories -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3">

                    <TextBlock
                        Text="CATEGORIES"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="6,0,0,8"/>


                    <ListBox
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        BorderThickness="0"
                        Background="Transparent"
                        MaxHeight="180"
                        ItemContainerStyle="{StaticResource NavListBoxItemStyle}"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Progress -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="5">


                    <Grid Margin="6,0,0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Column="0"
                            Text="PROGRESS"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextMutedBrush}"/>


                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding CompletionPercentage, StringFormat={}{0}%}"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="11"
                            FontWeight="Bold"/>

                    </Grid>


                    <!-- Progress Bar -->

                    <Border
                        Height="8"
                        CornerRadius="4"
                        Background="{StaticResource InputBrush}"
                        Margin="6,0,0,6">

                        <Border
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            behaviors:SmoothAnimation.TargetWidth="{Binding CompletionPercentage, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=190}">

                            <Border.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,0">

                                    <GradientStop
                                        Color="#8B7CF6"
                                        Offset="0"/>

                                    <GradientStop
                                        Color="#6C5CE7"
                                        Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                        </Border>

                    </Border>


                    <TextBlock
                        Text="{Binding StatusText}"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="6,0,0,10"/>


                    <Button
                        Content="Clear completed"
                        Style="{StaticResource SidebarButtonStyle}"
                        FontSize="12"
                        Command="{Binding ClearCompletedCommand}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- Main Content -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            Margin="28,24,28,24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Search Box -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Width="300"
                Height="38"
                HorizontalAlignment="Left"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="9"
                Margin="0,0,0,18">

                <Grid>


                    <!-- Search Icon -->

                    <TextBlock
                        Text="&#xE721;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="12,0,0,0"
                        IsHitTestVisible="False"/>


                    <!-- TextBox -->

                    <TextBox
                        x:Name="SearchBox"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="34,0,10,0"
                        VerticalContentAlignment="Center"
                        ToolTip="Search tasks..."/>


                    <!-- Placeholder -->

                    <TextBlock
                        Text="Search tasks..."
                        FontSize="13"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"
                        Margin="34,0,10,0"
                        IsHitTestVisible="False">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>


                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding Text, ElementName=SearchBox}"
                                        Value="">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- Todo List -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding TodosView}">


                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>


                            <!-- ================================================= -->
                            <!-- Todo Card -->
                            <!-- ================================================= -->

                            <Border
                                x:Name="card"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,10"
                                BorderThickness="1"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                AllowDrop="True"
                                DragOver="Card_DragOver"
                                Drop="Card_Drop">


                                <!-- Card Transform -->

                                <Border.RenderTransform>

                                    <TranslateTransform
                                        x:Name="cardOffset"
                                        Y="10"/>

                                </Border.RenderTransform>


                                <!-- Card Animation -->

                                <Border.Triggers>

                                    <EventTrigger
                                        RoutedEvent="FrameworkElement.Loaded">

                                        <BeginStoryboard>

                                            <Storyboard>


                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.22"/>


                                                <DoubleAnimation
                                                    Storyboard.TargetName="cardOffset"
                                                    Storyboard.TargetProperty="Y"
                                                    To="0"
                                                    Duration="0:0:0.28">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase
                                                            EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>


                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                </Border.Triggers>


                                <!-- Hover Style -->

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter
                                            Property="BorderBrush"
                                            Value="{StaticResource BorderBrush2}"/>


                                        <Style.Triggers>

                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">

                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>

                                            </Trigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>


                                <!-- ================================================= -->
                                <!-- Card Content -->
                                <!-- ================================================= -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <!-- Drag -->

                                        <ColumnDefinition Width="Auto"/>

                                        <!-- Priority Line -->

                                        <ColumnDefinition Width="6"/>

                                        <!-- Checkbox -->

                                        <ColumnDefinition Width="Auto"/>

                                        <!-- Content -->

                                        <ColumnDefinition Width="*"/>

                                        <!-- Buttons -->

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- ================================================= -->
                                    <!-- Drag Handle -->
                                    <!-- ================================================= -->

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="⠿"
                                        FontSize="14"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Cursor="SizeAll"
                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                        MouseMove="DragHandle_MouseMove"
                                        ToolTip="Drag to reorder"/>


                                    <!-- ================================================= -->
                                    <!-- Priority Indicator -->
                                    <!-- ================================================= -->

                                    <Border
                                        Grid.Column="1"
                                        Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="0,0,12,0"/>


                                    <!-- ================================================= -->
                                    <!-- CheckBox -->
                                    <!-- ================================================= -->

                                    <CheckBox
                                        Grid.Column="2"
                                        IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                        VerticalAlignment="Top"
                                        Margin="0,2,14,0"
                                        Cursor="Hand"/>


                                    <!-- ================================================= -->
                                    <!-- Todo Information -->
                                    <!-- ================================================= -->

                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center">


                                        <!-- Title -->

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"/>


                                        <!-- Description -->

                                        <TextBlock
                                            Text="{Binding Description}"
                                            FontSize="12.5"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Description, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>


                                        <!-- ================================================= -->
                                        <!-- Metadata -->
                                        <!-- ================================================= -->

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,7,0,0">


                                            <!-- Category -->

                                            <Border
                                                Background="{StaticResource InputBrush}"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding Category, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">

                                                <TextBlock
                                                    Text="{Binding Category}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- Priority Badge -->
                                            <!-- ================================================= -->

                                            <Border
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}">

                                                <TextBlock
                                                    Text="{Binding PriorityText}"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"/>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- Due Date -->
                                            <!-- ================================================= -->

                                            <TextBlock
                                                Text="{Binding DueDateDisplay}"
                                                FontSize="11">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource TextSecondaryBrush}"/>


                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding IsOverdue}"
                                                                Value="True">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}"/>

                                                                <Setter
                                                                    Property="FontWeight"
                                                                    Value="SemiBold"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </StackPanel>

                                    </StackPanel>


                                    <!-- ================================================= -->
                                    <!-- Edit / Delete -->
                                    <!-- ================================================= -->

                                    <StackPanel
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">


                                        <!-- Edit -->

                                        <Button
                                            Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0"/>


                                        <!-- Delete -->

                                        <Button
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>